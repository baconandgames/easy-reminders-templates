#!/usr/bin/env python3
from __future__ import annotations

import argparse
import sys
from pathlib import Path
from typing import Any

from src.config import Config, ConfigLoadError, load_config
from src.delivery import DeliveryResult, get_delivery_target
from src.formatter import ColorScheme, build_shopping_list, format_number, render_shopping_list
from src.recipes import RecipeLoadError, find_recipe_by_short_name, load_recipes


def main() -> int:
	parser: argparse.ArgumentParser = argparse.ArgumentParser(
		prog="shop",
		description="Generate a shopping list from a recipe.",
	)
	parser.add_argument("short_name", nargs="?", help="recipe short name")
	args: argparse.Namespace = parser.parse_args()

	project_dir: Path = Path(__file__).resolve().parent

	try:
		config: Config = load_config(project_dir / "config.json")
	except ConfigLoadError as error:
		print(f"Error: {error}", file=sys.stderr)
		return 1

	try:
		recipes: dict[str, dict[str, Any]] = load_recipes(project_dir / "recipes.json")
	except RecipeLoadError as error:
		print(f"Error: {error}", file=sys.stderr)
		return 1

	if args.short_name is None:
		recipe = select_recipe(recipes)
	else:
		try:
			match: tuple[str, dict[str, Any]] | None = find_recipe_by_short_name(recipes, args.short_name)
		except RecipeLoadError as error:
			print(f"Error: {error}", file=sys.stderr)
			return 1

		if match is None:
			print(f'Error: no recipe found with short name "{args.short_name}".', file=sys.stderr)
			return 1

		_recipe_id, recipe = match

	batch_size: float = prompt_for_batch_size(recipe)
	include_on_hand: bool = prompt_for_include_on_hand(config.include_on_hand_default)
	shopping_list = build_shopping_list(
		recipe,
		batch_size,
		include_on_hand,
		append_short_name=config.append_short_name,
	)

	color_scheme: ColorScheme = ColorScheme(
		standard_text_color=config.standard_text_color,
		quantity_color=config.quantity_color,
		omitted_ingredient_color=config.omitted_ingredient_color,
	)
	print(render_shopping_list(shopping_list, color_scheme=color_scheme, include_omitted=not include_on_hand))
	delivery_result: DeliveryResult = get_delivery_target(config.target_app).create_list(shopping_list, config)
	print()
	print(render_delivery_result(delivery_result))

	return 0


def render_delivery_result(result: DeliveryResult) -> str:
	status: str = "Dry run" if result.dry_run else "Created"
	item_label: str = "item" if len(result.created_items) == 1 else "items"
	omitted_label: str = "item" if len(result.omitted_items) == 1 else "items"

	return "\n".join(
		[
			f"{status}: {result.target_name}",
			f"Parent: {result.created_parent}",
			f"Included: {len(result.created_items)} {item_label}",
			f"Omitted: {len(result.omitted_items)} {omitted_label}",
		]
	)


def select_recipe(recipes: dict[str, dict[str, Any]]) -> dict[str, Any]:
	recipe_options: list[dict[str, Any]] = list(recipes.values())

	print("Available recipes:")
	for index, recipe in enumerate(recipe_options, start=1):
		short_name: str = recipe.get("short_name", recipe["name"])
		print(f"{index}. {short_name}: {recipe['name']}")

	while True:
		selection: str = input("Select a recipe: ").strip()
		if selection == "":
			print("Enter a recipe number.")
			continue

		try:
			selected_index: int = int(selection)
		except ValueError:
			print("Enter a recipe number.")
			continue

		if 1 <= selected_index <= len(recipe_options):
			return recipe_options[selected_index - 1]

		print(f"Enter a number from 1 to {len(recipe_options)}.")


def prompt_for_batch_size(recipe: dict[str, Any]) -> float:
	default_batch: float = float(recipe["default_batch"])
	default_display: str = format_number(default_batch)

	while True:
		selection: str = input(f"Batch size [{default_display}]: ").strip()
		if selection == "":
			return default_batch

		try:
			batch_size: float = float(selection)
		except ValueError:
			print("Enter a positive number.")
			continue

		if batch_size > 0:
			return batch_size

		print("Enter a positive number.")


def prompt_for_include_on_hand(default: bool) -> bool:
	prompt: str = "Include on-hand items? [Y/n]: " if default else "Include on-hand items? [y/N]: "

	while True:
		selection: str = input(prompt).strip().casefold()
		if selection == "":
			return default

		if selection in {"y", "yes"}:
			return True

		if selection in {"n", "no"}:
			return False

		print("Enter y or n.")


if __name__ == "__main__":
	raise SystemExit(main())
